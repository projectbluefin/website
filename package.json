{
  "name": "project-bluefin-website",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-wallpapers.js && vite",
    "build": "node scripts/generate-wallpapers.js && node scripts/generate-social-cards.js && vue-tsc && vite build",
    "generate:social-cards": "node scripts/generate-social-cards.js",
    "generate:social-cards:all": "node scripts/generate-social-cards.js --all",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:gate": "node scripts/test-baseline.mjs",
    "test:gate:update": "node scripts/test-baseline.mjs --update",
    "typecheck": "vue-tsc --noEmit",
    "update:wolves-playlist": "node scripts/update-wolves-playlist.js",
    "update:back-catalogue": "node scripts/update-back-catalogue.js",
    "record:wolves": "node record-wolves.cjs",
    "generate:wolves-qrs": "node scripts/generate-qrs.js",
    "check:docs": "node scripts/check-docs.mjs",
    "check:git-hygiene": "node scripts/check-git-hygiene.mjs",
    "test:git-hygiene": "node scripts/check-git-hygiene.mjs --self-test",
    "update:image-versions": "node scripts/update-image-versions.js",
    "check:image-sboms": "node scripts/update-image-versions.js --check-only"
  },
  "dependencies": {
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@iconify-prerendered/vue-mdi": "^0.28.1737398331",
    "@iframe-resizer/child": "5.5.9",
    "@iframe-resizer/parent": "5.5.9",
    "@iframe-resizer/vue": "5.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^6.0.0",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.0",
    "sass": "^1.105.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "3.3.13"
  }
}